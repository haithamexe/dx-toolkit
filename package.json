{
  "name": "dx-toolkit",
  "version": "1.2.0",
  "license": "MIT",
  "private": true,
  "description": "Personal developer toolkit: one tools library, reachable from the dx dashboard, the dx command, Raycast and MCP.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/web",
    "packages/cli",
    "packages/mcp"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/web packages/cli packages/mcp",
    "watch": "tsc -b -w packages/core packages/web packages/cli packages/mcp",
    "clean": "tsc -b --clean packages/core packages/web packages/cli packages/mcp",
    "test": "npm run build && node --test \"packages/core/dist/__tests__/*.test.js\" \"packages/web/dist/__tests__/*.test.js\" \"packages/mcp/dist/__tests__/*.test.js\" \"packages/cli/dist/__tests__/*.test.js\"",
    "link": "npm install -g ./packages/cli",
    "raycast:install": "npm install --prefix packages/raycast",
    "raycast:dev": "npm run dev --prefix packages/raycast",
    "ui": "node packages/cli/dist/index.js ui",
    "release": "npm run build && node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
