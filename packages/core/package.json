{
  "name": "@dx/core",
  "version": "1.10.0",
  "license": "MIT",
  "private": true,
  "description": "The tools themselves. No dependencies beyond Node, so every front end can bundle it.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hook": {
      "types": "./dist/tools/hookrules.d.ts",
      "import": "./dist/tools/hookrules.js",
      "default": "./dist/tools/hookrules.js"
    }
  },
  "files": [
    "dist"
  ]
}
